  "connections": {
    "Rizon": {
      "auto_rejoin": false,
      "channels": [
        "#uguubot",
        "#devbot"
      ],
      "command_prefix": ".,+",
      "invite_join": false,
      "nick": "uguubot2",
      "nickserv_password": "",
      "realname": "uguu",
      "server": "irc.rizon.io",
      "user": "uguu"
    }
  },
  "disabled_commands": [],
  "disabled_plugins": [],
  "ignored": [
    "nick!user@host"
  ],
  "owner": "infinity",
  "plugins": {
    "factoids": {
      "prefix": false
    },
    "times": {
      "format": "%I:%M %p %Z",
      "separator": " | ",
      "time_zones": [
        ["Los Angeles", "America/Los_Angeles"],
        ["New York", "America/New_York"],
        ["London", "Europe/London"],
        ["Berlin", "Europe/Berlin"],
        ["Kiev", "Europe/Kiev"],
        ["Tokyo", "Asia/Tokyo"]
      ]
    }
  }
}
